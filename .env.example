# ==========================================
# AI Interviewer - Environment Configuration
# ==========================================

# Database Configuration (PostgreSQL / Supabase)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
DB_POOL_SIZE=10
SHOW_SQL=false

# Server Configuration
SERVER_PORT=8082

# Mail Configuration (Gmail SMTP or other)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-password

# LLM Configuration (Groq / OpenAI)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_NAME=openai/gpt-oss-120b
OPENAI_TEMPERATURE=0.3
OPENAI_TIMEOUT_SECONDS=60

# LiveKit WebRTC Configuration
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-subdomain.livekit.cloud

# Speech-to-Text (Deepgram)
DEEPGRAM_API_KEY=your_deepgram_api_key

# Text-to-Speech (OpenAI TTS)
OPENAI_TTS_API_KEY=your_openai_tts_api_key
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# Supabase Auth / Project Keys (Optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
